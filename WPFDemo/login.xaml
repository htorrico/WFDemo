<Window x:Class="WPFDemo.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFDemo"
        mc:Ignorable="d"
        Title="login"
        Width="420"
        Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F3F4F6">

        <Border Width="340"
                Padding="30"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0"
                           Text="Iniciar sesión"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Subtítulo -->
                <TextBlock Grid.Row="1"
                           Text="Ingresa tus datos para continuar"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Usuario -->
                <StackPanel Grid.Row="2"
                            Margin="0,0,0,15">

                    <TextBlock Text="Usuario"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtUsuario"
                             Height="40"
                             FontSize="16"
                             Padding="8"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Grid.Row="3"
                            Margin="0,0,0,15">

                    <TextBlock Text="Contraseña"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <PasswordBox x:Name="txtContrasena"                                 
                                 Height="40"
                                 FontSize="16"
                                 Padding="8"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Recordar contraseña -->
                <CheckBox x:Name="chkRecordarme"
                          Grid.Row="4"
                          Content="Recordarme"
                          Margin="0,0,0,20"/>

                <!-- Botón ingresar -->
                <Button x:Name="btnIngresar"
                        Grid.Row="5"
                        Content="Ingresar"
                        Height="45"
                        FontSize="16"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnIngresar_Click"
                        />

                <!-- Mensaje -->
                <TextBlock x:Name="txtMensaje"
                           Grid.Row="6"
                           Text=""
                           Foreground="Red"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>

            </Grid>
        </Border>
    </Grid>
</Window>
