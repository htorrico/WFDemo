<Window x:Class="WPFDemo.calculadora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFDemo"
        mc:Ignorable="d"
        Title="calculadora" Height="500" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Pantalla -->
        <TextBox x:Name="txtResultado"
                 Grid.Row="0"
                 Margin="5"
                 Text="0"
                 FontSize="36"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"/>

        <!-- Botones -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Primera fila -->
            <Button Grid.Row="0"
                    Grid.Column="0"
                    Margin="4"
                    FontSize="20"
                    Content="C"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Margin="4"
                    FontSize="20"
                    Content="±"/>

            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="4"
                    FontSize="20"
                    Content="%"/>

            <Button Grid.Row="0"
                    Grid.Column="3"
                    Margin="4"
                    FontSize="20"
                    Content="÷"/>

            <!-- Segunda fila -->
            <Button Grid.Row="1"
                    Grid.Column="0"
                    Margin="4"
                    FontSize="20"
                    Content="7"/>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Margin="4"
                    FontSize="20"
                    Content="8"/>

            <Button Grid.Row="1"
                    Grid.Column="2"
                    Margin="4"
                    FontSize="20"
                    Content="9"/>

            <Button Grid.Row="1"
                    Grid.Column="3"
                    Margin="4"
                    FontSize="20"
                    Content="×"/>

            <!-- Tercera fila -->
            <Button Grid.Row="2"
                    Grid.Column="0"
                    Margin="4"
                    FontSize="20"
                    Content="4"/>

            <Button Grid.Row="2"
                    Grid.Column="1"
                    Margin="4"
                    FontSize="20"
                    Content="5"/>

            <Button Grid.Row="2"
                    Grid.Column="2"
                    Margin="4"
                    FontSize="20"
                    Content="6"/>

            <Button Grid.Row="2"
                    Grid.Column="3"
                    Margin="4"
                    FontSize="20"
                    Content="-"/>

            <!-- Cuarta fila -->
            <Button Grid.Row="3"
                    Grid.Column="0"
                    Margin="4"
                    FontSize="20"
                    Content="1"/>

            <Button Grid.Row="3"
                    Grid.Column="1"
                    Margin="4"
                    FontSize="20"
                    Content="2"/>

            <Button Grid.Row="3"
                    Grid.Column="2"
                    Margin="4"
                    FontSize="20"
                    Content="3"/>

            <Button Grid.Row="3"
                    Grid.Column="3"
                    Margin="4"
                    FontSize="20"
                    Content="+"/>

            <!-- Quinta fila -->
            <Button Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="4"
                    FontSize="20"
                    Content="0"/>

            <Button Grid.Row="4"
                    Grid.Column="2"
                    Margin="4"
                    FontSize="20"
                    Content="."/>

            <Button Grid.Row="4"
                    Grid.Column="3"
                    Margin="4"
                    FontSize="20"
                    Content="="/>

        </Grid>

    </Grid>
</Window>
